{
    "manifest_version": 3,
    "name": "Personal Activity Monitor",
    "version": "0.1.0",
    "description": "Local Chrome activity monitor for a personal AI assistant.",
    "permissions": [
      "tabs",
      "storage"
    ],
    "host_permissions": [
      "<all_urls>"
    ],
    "background": {
      "service_worker": "background.js"
    },
    "content_scripts": [
      {
        "matches": ["<all_urls>"],
        "js": ["content.js"],
        "run_at": "document_idle"
      }
    ]
  }
