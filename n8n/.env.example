# Copy to .env and fill in. Never commit .env.

# Port n8n listens on
N8N_PORT=5678

# Encrypts credentials stored in n8n. Generate once and keep it —
# changing it later makes saved credentials unreadable.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
N8N_ENCRYPTION_KEY=

GENERIC_TIMEZONE=Asia/Kolkata
TZ=Asia/Kolkata

N8N_HOST=localhost
N8N_LISTEN_ADDRESS=127.0.0.1
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
N8N_RUNNERS_ENABLED=true
N8N_DIAGNOSTICS_ENABLED=false
# n8n stores its database and settings in <this folder>/.n8n
N8N_USER_FOLDER=./data

# Max webhook request size in MB (full page HTML can be large)
N8N_PAYLOAD_SIZE_MAX=64
